# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epibat?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Mist AI ───────────────────────────────────────────────────────────────
MIST_API_TOKEN="your-mist-api-token-here"
MIST_SITE_ID="your-mist-site-id"
MIST_ORG_ID="your-mist-org-id"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-use-a-real-secret"

# ─── CORS ───────────────────────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:3000"

# ─── MAC Hashing ────────────────────────────────────────────────────────────
MAC_HASH_SALT="epibat-gdpr-salt-change-me"
